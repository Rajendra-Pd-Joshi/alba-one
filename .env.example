# ==============================================================================
# ALBA ONE — Environment Configuration (.env.example)
# ALBACONNECT Inc. (Tokyo; ISMS-certified)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application & Runtime / アプリケーション基本設定
# ------------------------------------------------------------------------------
APP_ENV=development
DEFAULT_LANGUAGE=ja
LOG_LEVEL=INFO
MODEL_CONFIG_PATH=config/models.yaml
STARTUP_PING_ENABLED=false
OPENAPI_DOCS_ENABLED=false
CORS_ALLOWED_ORIGINS=https://alba-one.albaconnect.co.jp
CORS_ALLOW_CREDENTIALS=true
TRACE_CAPTURE_CONTENT=false

# ------------------------------------------------------------------------------
# 2. LLM, Embedding & Rerank Models / LLM・埋め込み・リランクモデル設定
# ------------------------------------------------------------------------------
MAIN_MODEL=gpt-4o-2024-08-06
JUDGE_MODEL=gpt-4o-2024-08-06
EVAL_JUDGE_MODEL=claude-3-5-sonnet-20241022
FALLBACK_MODELS=gpt-4o-mini-2024-07-18

EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536

# Reranker provider ("cohere_direct" | "gateway") and model slug (check your gateway's docs for its exact slug):
# - cohere_direct (Cohere v2 API): rerank-v4.0-pro (default), rerank-v3.5, rerank-multilingual-v3.0
# - gateway (Portkey/LiteLLM/Bifrost/TensorZero/Mesh): rerank-4-pro, cohere/rerank-4-pro, cohere/rerank-v4-pro
RERANK_PROVIDER=cohere_direct
RERANK_MODEL=rerank-v4.0-pro
RERANK_FALLBACK_MODEL=
RERANK_TOP_K=5

# ------------------------------------------------------------------------------
# 3. Retrieval Pipeline Settings / 検索パイプライン設定 (Phase 3)
# ------------------------------------------------------------------------------
DEFAULT_CHUNKING_STRATEGY=parent_child
QUERY_REWRITE_COUNT=4
RELEVANCE_THRESHOLD=0.35
ALLOW_EXTERNAL_FALLBACK=true
ENABLE_MULTIMODAL_RAG=false

MODEL_PRICES_JSON={"gpt-4o-2024-08-06":{"input_per_1m":2.5,"output_per_1m":10.0},"gpt-4o-mini-2024-07-18":{"input_per_1m":0.15,"output_per_1m":0.6},"claude-3-5-sonnet-20241022":{"input_per_1m":3.0,"output_per_1m":15.0},"text-embedding-3-large":{"input_per_1m":0.13,"output_per_1m":0.0},"rerank-v4.0-pro":{"input_per_1m":2.0,"output_per_1m":0.0}}

# ------------------------------------------------------------------------------
# 4. LLM Gateway / LLMゲートウェイ設定
# ------------------------------------------------------------------------------
GATEWAY_PROVIDER=portkey
GATEWAY_BASE_URL=https://api.portkey.ai/v1
GATEWAY_API_KEY=replace-with-portkey-api-key
GATEWAY_EXTRA_HEADERS_JSON={"x-portkey-provider":"openai"}
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 5. Upstream Model & Vector Providers / 外部プロバイダ認証情報
# ------------------------------------------------------------------------------
OPENAI_API_KEY=replace-with-openai-api-key
PINECONE_API_KEY=replace-with-pinecone-api-key
PINECONE_INDEX_NAME=alba-one-kb
PINECONE_HOST=https://alba-one-kb-example.svc.aped-4627-b74a.pinecone.io
COHERE_API_KEY=replace-with-cohere-api-key

# ------------------------------------------------------------------------------
# 6. Data Stores & Cache / データベース・キャッシュ・レート制限設定
# ------------------------------------------------------------------------------
# Production requires sslmode=verify-full (or require) and rediss:// with auth
# 本番環境では sslmode=verify-full（または require）および rediss://（認証付き）が必須
DATABASE_URL=postgresql+psycopg://alba:alba_dev_password@localhost:5432/alba_one
REDIS_URL=redis://localhost:6379/0
LLM_CACHE_TTL_SECONDS=86400
RATE_LIMIT_TENANT_RPM=300
RATE_LIMIT_TENANT_BURST=60
RATE_LIMIT_USER_RPM=60
RATE_LIMIT_USER_BURST=15
RATE_LIMIT_TOOL_RPM=120
RATE_LIMIT_TOOL_BURST=30

# ------------------------------------------------------------------------------
# 7. Guardrails, Memory & Operational Controls / ガードレール・メモリ・運用統制 (Phase 4)
# ------------------------------------------------------------------------------
AWS_REGION=ap-northeast-1
BEDROCK_GUARDRAIL_ID=replace-with-bedrock-guardrail-id
BEDROCK_GUARDRAIL_VERSION=1

# Safeguard tier: "STANDARD" is required for Japanese language support ("CLASSIC" only supports EN/FR/ES)
# ガードレールティア: 日本語対応には "STANDARD" が必須（"CLASSIC" は英・仏・西のみ対応）
BEDROCK_GUARDRAIL_TIER=STANDARD

# Cross-region guardrail profile required by STANDARD tier (for ap-northeast-1: apac.guardrail.v1:0)
# Note: routes guardrail inference across APAC regions (see docs/SECURITY.md & docs/DATA_FLOWS.md)
# STANDARDティアで必須のクロスリージョン推論プロファイル（東京リージョンは apac.guardrail.v1:0）
BEDROCK_GUARDRAIL_CROSS_REGION_PROFILE=apac.guardrail.v1:0

# Global guardrail enforcement mode ("enforce" blocks/masks; "monitor" maps to Detect mode & logs only)
# ガードレール動作モード（"enforce": 遮断・マスク適用 / "monitor": 検知ログ記録のみ）
GUARDRAIL_MODE=enforce
ALLOW_GUARDRAIL_MONITOR_IN_PROD=false
FETCH_DOMAIN_POLICY=denylist
OUTBOUND_QUERY_POLICY=block

# Long-term memory provider ("mem0" [default self-hosted OSS] | "langmem" | "in_memory")
# 長期メモリプロバイダ（"mem0"［デフォルトOSS自前ホスト］ | "langmem" | "in_memory"）
MEMORY_PROVIDER=mem0
MEM0_API_KEY=self-hosted-oss
MEM0_ORG_ID=alba-connect
MEMORY_DEFAULT_TTL_SECONDS=7776000

# Operational Guardrail Limits & Kill Switch / 運用ガードレール上限・キルスイッチ
OPS_MAX_TOKENS_PER_REQUEST=32000
OPS_MAX_COST_USD_PER_REQUEST=1.50
OPS_MAX_COST_USD_PER_TENANT_DAILY=250.00
OPS_MAX_GRAPH_STEPS=15
OPS_MAX_TOOL_CALLS_PER_RUN=10
OPS_KILL_SWITCH=false

# LangSmith tracing & online evaluation settings
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=replace-with-langsmith-api-key
LANGSMITH_PROJECT=alba-one-dev

# ------------------------------------------------------------------------------
# 8. OIDC / JWKS Auth & S2S Dual-Secret Rotation (Phase 10) / OIDC認証・内部トークンローテーション設定
# ------------------------------------------------------------------------------
# AUTH_STUB_ENABLED must be false in staging/production (enforced by startup_checks.py)
# 本番・ステージング環境では AUTH_STUB_ENABLED=false が必須（起動時チェックで強制）
AUTH_STUB_ENABLED=true
DEFAULT_TENANT_ID=tenant_alba_demo
DEFAULT_USER_ID=user_analyst_01
DEFAULT_USER_ROLE=analyst

OIDC_ISSUER=https://idp.albaconnect.co.jp/oauth2/default
OIDC_AUDIENCE=api://alba-one
OIDC_JWKS_URL=https://idp.albaconnect.co.jp/oauth2/default/v1/keys
OIDC_ALLOWED_ALGORITHMS=RS256,ES256
OIDC_LEEWAY_SECONDS=30
OIDC_MAX_TOKEN_AGE_SECONDS=3600
OIDC_CLAIM_TENANT=tenant_id
OIDC_CLAIM_ROLES=roles
OIDC_CLAIM_LANG=lang
OIDC_STEP_UP_CLAIM=amr
OIDC_STEP_UP_VALUES=mfa,hwk,otp,webauthn
OIDC_REQUIRE_STEP_UP_FOR_APPROVALS=false
JWKS_TTL_SECONDS=300
JWKS_MAX_STALE_SECONDS=3600
JWKS_MIN_REFRESH_INTERVAL_SECONDS=30

# Dual-secret internal bearer rotation (accepts current and previous during rotation window)
# 無停止ローテーション用の内部S2Sシークレット（ローテーション期間中は新旧2つのシークレットを受理）
INTERNAL_S2S_CURRENT_SECRET=replace-with-internal-s2s-secret
INTERNAL_S2S_PREVIOUS_SECRET=
INTERNAL_S2S_PREVIOUS_SECRET_EXPIRES_AT=0

# ==============================================================================
# 9. Hypothesis Generator & Tool-Gathering Budgets (Phase 6)
# JA: 仮説生成および2ラウンド制ツール収集予算（TODO(owner): tune from measured ops evals）
# EN: Hypothesis generation & 2-round tool-gathering budgets (TODO(owner): tune from measured ops evals)
# ==============================================================================
MAX_OPTIONS=4                    # Candidate options generated alongside mandatory baseline (TODO(owner): tune from measured ops evals)
MAX_TOOL_CALLS_PER_RUN=10        # Hard cap on total MCP tool calls per hypothesis run (TODO(owner): tune from measured ops evals)
ROUND1_MAX_CALLS=6               # Max tool calls in Round 1 broad gathering (TODO(owner): tune from measured ops evals)
ROUND2_MAX_CALLS=4               # Max tool calls in Round 2 gap-filling + counter-evidence (TODO(owner): tune from measured ops evals)
TOOL_TIMEOUT_SECONDS=10.0        # Per-call timeout for parallel asyncio.gather execution (TODO(owner): tune from measured ops evals)
MAX_RUN_COST=0.50                # Max USD cost budget per hypothesis run before stopping gathering (TODO(owner): tune from measured ops evals)
